rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Bootstrap rule: replace with a Firebase custom claim before adding more
    // operators. Verified email prevents an unverified account from using the
    // administrative console.
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email == "agarwaltanmay401@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function ownerUserCreateFields() {
      return [
        "uid",
        "name",
        "email",
        "username",
        "bio",
        "avatarUri",
        "avatarResizeMode",
        "emailVerified",
        "pendingVerification",
        "verifiedAt",
        "authProvider",
        "createdAt",
        "lastActive",
        "pushToken",
        "pushTokenPlatform",
        "pushTokenUpdatedAt",
        "notificationPermission"
      ];
    }

    function ownerUserUpdateFields() {
      return [
        "name",
        "bio",
        "avatarUri",
        "avatarResizeMode",
        "emailVerified",
        "pendingVerification",
        "verifiedAt",
        "lastActive",
        "pushToken",
        "pushTokenPlatform",
        "pushTokenUpdatedAt",
        "notificationPermission"
      ];
    }

    function validOwnerIdentity(userId) {
      return request.resource.data.uid == userId &&
        (!request.resource.data.keys().hasAny(["email"]) || request.resource.data.email == request.auth.token.email);
    }

    function validOwnerVerificationUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(["emailVerified", "pendingVerification", "verifiedAt"]) ||
        (
          request.auth.token.email_verified == true &&
          request.resource.data.emailVerified == true &&
          request.resource.data.pendingVerification == false
        );
    }

    // Lock down user collections (profile, expenses, notifications, settings)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly(ownerUserCreateFields()) &&
        validOwnerIdentity(userId) &&
        !request.resource.data.keys().hasAny(["subscription", "role", "admin", "isAdmin"])
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerUserUpdateFields()) &&
        validOwnerIdentity(userId) &&
        validOwnerVerificationUpdate()
      );
      allow delete: if isAdmin();

      match /expenses/{expenseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin() || (
          signedIn() && (
            (request.resource != null && request.resource.data.householdCreatedBy == request.auth.uid) ||
            (resource != null && resource.data.householdCreatedBy == request.auth.uid)
          )
        );
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /receivables/{receivableId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // A create-only username reservation. The profile collection remains
    // private, so usernames never become a way to enumerate account emails.
    match /usernames/{username} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["uid", "createdAt"]) &&
        request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Collection-group reads used by the authenticated admin monitor.
    match /{path=**}/expenses/{expenseId} {
      allow read: if isAdmin();
    }

    match /{path=**}/notifications/{notificationId} {
      allow read: if isAdmin();
    }

    function isHouseholdMember(householdId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    function isHouseholdAdmin(householdId) {
      return isHouseholdMember(householdId) &&
        get(/databases/$(database)/documents/households/$(householdId)).data.members[request.auth.uid].role == "admin";
    }

    // Household membership is required for read/write access. An invite code
    // can be used only to add the signed-in user as a regular member.
    match /households/{householdId} {
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberUids.size() == 1 &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.members[request.auth.uid].role == "admin";
      // A direct document lookup is the invite-code join handshake. Listing
      // households remains limited to members, so users cannot enumerate them.
      allow get: if signedIn();
      allow list: if isHouseholdMember(householdId) || isAdmin();
      allow update: if isHouseholdAdmin(householdId) || isAdmin() || (
        !isHouseholdMember(householdId) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.resource.data.members[request.auth.uid].role == "member" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "memberUids"])
      );
      allow delete: if isHouseholdAdmin(householdId) || isAdmin();

      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId) || isAdmin();
        allow create: if isHouseholdMember(householdId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.householdId == householdId;
        allow update, delete: if (isHouseholdMember(householdId) &&
          resource.data.createdBy == request.auth.uid) || isHouseholdAdmin(householdId) || isAdmin();
      }
    }

    // Lock down statement downloads requests
    match /statement_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }


    // Lock down support cases (raised by FAQ panel)
    match /support_cases/{caseId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /broadcast_history/{broadcastId} {
      allow read, write: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    // App Configuration (Pricing, Plan matrices, Feature flags)
    match /app_config/{configDoc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
