# Data ownership switch. Keep firebase until the Go API migration is complete.
EXPO_PUBLIC_DATA_BACKEND=firebase

# Required only when EXPO_PUBLIC_DATA_BACKEND=api.
# Android Emulator: http://10.0.2.2:8080/api/v1
# Production: https://api.example.com/api/v1
EXPO_PUBLIC_API_URL=

# Firebase client configuration (public identifiers, not service-account secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Observability; use a distinct DSN per environment.
EXPO_PUBLIC_SENTRY_DSN=
